# mock works without credentials. meta requires verified account configuration.
AI_PROVIDER=mock
HOST=127.0.0.1
PORT=8787
# Full HTTPS chat-completions endpoint from your Meta account documentation.
META_CHAT_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.3
META_API_KEY=
# Official quickstart name; Start-QuestAI.ps1 maps it to META_API_KEY.
MODEL_API_KEY=
WSL_DISTRO=Ubuntu
MUSE_CLI_PATH=/home/ferrarioswolf/.local/bin/muse
MUSE_CLI_MODEL=muse-spark-1.3-contributor
# Required when binding beyond localhost. This is NOT the Meta API key.
APP_TOKEN=
